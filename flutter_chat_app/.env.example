# ===================================================================
# Sharitek Office Chat — Firebase Environment Variables
# ===================================================================
#
# Copy this file to .env.staging or .env.production and fill in
# the actual values from your Firebase Console.
#
# Usage:
#   flutter run --dart-define-from-file=.env.staging
#   flutter run --dart-define-from-file=.env.production
#
# Get values from: https://console.firebase.google.com
#   → Project Settings → General → Your apps
#
# ===================================================================

# === Flavor (staging | production) ===
FLAVOR=staging

# === API Endpoints ===
API_BASE_URL=https://api-staging.oxii.chat
SOCKET_URL=wss://ws-staging.oxii.chat

# === Firebase: Common (all platforms) ===
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# === Firebase: Web ===
FIREBASE_WEB_API_KEY=AIzaSy_your_web_api_key_here
FIREBASE_WEB_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# === Firebase: Android ===
FIREBASE_ANDROID_API_KEY=AIzaSy_your_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxx

# === Firebase: iOS ===
FIREBASE_IOS_API_KEY=AIzaSy_your_ios_api_key_here
FIREBASE_IOS_APP_ID=1:000000000000:ios:xxxxxxxxxxxx
FIREBASE_IOS_BUNDLE_ID=com.oxii.chat
