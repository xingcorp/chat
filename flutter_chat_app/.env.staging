# STAGING ENVIRONMENT CONFIGURATION
# Environment variables cho staging flavor

# Application Configuration
APP_NAME=OXII Chat STG
APP_VERSION=1.0.0+1
FLAVOR=staging
ENVIRONMENT=staging

# API Configuration
API_BASE_URL=https://api-staging.oxii.chat
WEBSOCKET_URL=wss://ws-staging.oxii.chat
API_VERSION=v1
API_TIMEOUT=30000

GRAPHQL_API_URL=https://api-staging.oxii.chat/graphql
GRAPHQL_WS_URL=wss://ws-staging.oxii.chat/graphql
SOCKET_URL=wss://ws-staging.oxii.chat

# Firebase Configuration
FIREBASE_PROJECT_ID=oxii-chat-staging
FIREBASE_API_KEY=AIzaSyDemoStagingKey123456789
FIREBASE_APP_ID=1:123456789:android:staging123456789
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_STORAGE_BUCKET=oxii-chat-staging.appspot.com

# Database Configuration
DATABASE_NAME=oxii_chat_staging.db
DATABASE_VERSION=1
ENABLE_DATABASE_ENCRYPTION=true

# Security Configuration
ENABLE_SSL_PINNING=false
ENABLE_ROOT_DETECTION=false
ENABLE_JAILBREAK_DETECTION=false
JWT_SECRET=staging_jwt_secret_key_demo_only

# Feature Flags
ENABLE_NEW_CHAT_UI=true
ENABLE_VOICE_MESSAGES=true
ENABLE_VIDEO_CALL=true
ENABLE_GROUP_CHAT=true
ENABLE_FILE_SHARING=true
ENABLE_LOCATION_SHARING=true
ENABLE_MESSAGE_REACTIONS=true
ENABLE_MESSAGE_FORWARDING=true
ENABLE_CHAT_BACKUP=true
ENABLE_END_TO_END_ENCRYPTION=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_DARK_MODE=true
ENABLE_NOTIFICATION_SCHEDULING=true
ENABLE_OFFLINE_MODE=true
ENABLE_ADVANCED_SEARCH=true

# Monitoring Configuration
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ANALYTICS_DEBUG_MODE=true

# Debug Configuration
LOG_LEVEL=DEBUG
ENABLE_MOCK_DATA=true
ENABLE_DEBUG_TOOLS=true
ENABLE_NETWORK_LOGGING=true
ENABLE_PERFORMANCE_OVERLAY=false

# Cache Configuration
CACHE_TIMEOUT_MINUTES=5
MAX_CACHE_SIZE_MB=100
ENABLE_CACHE_ENCRYPTION=false

# Network Configuration
REQUEST_TIMEOUT_SECONDS=30
CONNECT_TIMEOUT_SECONDS=15
RECEIVE_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2

# Push Notification Configuration
FCM_SERVER_KEY=staging_fcm_server_key_demo
ENABLE_PUSH_NOTIFICATIONS=true
NOTIFICATION_CHANNEL_ID=oxii_chat_staging_notifications

# Third-party Services
GOOGLE_MAPS_API_KEY=staging_google_maps_api_key
AGORA_APP_ID=staging_agora_app_id
AGORA_APP_CERTIFICATE=staging_agora_certificate

# Upload Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,mp4,mp3
UPLOAD_TIMEOUT_SECONDS=60

# Chat Configuration
MAX_MESSAGE_LENGTH=4000
MAX_GROUP_MEMBERS=500
MESSAGE_HISTORY_DAYS=365
ENABLE_MESSAGE_ENCRYPTION=true

# Performance Configuration
IMAGE_CACHE_SIZE_MB=50
VIDEO_CACHE_SIZE_MB=100
AUDIO_CACHE_SIZE_MB=25
PRELOAD_RECENT_CHATS=10

# Development Tools
ENABLE_FLUTTER_INSPECTOR=true
ENABLE_PERFORMANCE_PROFILER=true
ENABLE_MEMORY_PROFILER=true
ENABLE_NETWORK_PROFILER=true
