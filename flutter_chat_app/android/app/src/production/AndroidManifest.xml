<!-- PRODUCTION FLAVOR ANDROID MANIFEST -->
<!-- Production-specific configuration cho OXII Chat -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config_production"
        android:usesCleartextTraffic="false"
        android:debuggable="false">
        
        <!-- Production-specific metadata -->
        <meta-data
            android:name="com.oxii.chat.ENVIRONMENT"
            android:value="production" />
            
        <meta-data
            android:name="com.oxii.chat.API_BASE_URL"
            android:value="https://oxii-office-api.oxiitek.com" />
            
        <meta-data
            android:name="com.oxii.chat.ENABLE_DEBUG_TOOLS"
            android:value="false" />
            
        <!-- Firebase Messaging Service -->
        <service
            android:name="com.oxii.chat.firebase.ProductionMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        
        <!-- Production notification channels -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
            
        <!-- Production app shortcuts -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts_production" />
            
        <!-- Security configurations -->
        <meta-data
            android:name="com.oxii.chat.ENABLE_SSL_PINNING"
            android:value="true" />
            
        <meta-data
            android:name="com.oxii.chat.ENABLE_ROOT_DETECTION"
            android:value="true" />
            
    </application>
    
</manifest>
