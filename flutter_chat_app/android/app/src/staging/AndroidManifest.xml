<!-- STAGING FLAVOR ANDROID MANIFEST -->
<!-- Staging-specific configuration cho OXII Chat STG -->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Staging-specific permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config_staging"
        android:usesCleartextTraffic="true"
        tools:replace="android:label,android:allowBackup,android:networkSecurityConfig,android:usesCleartextTraffic">

        <!-- Staging-specific metadata -->
        <meta-data
            android:name="com.oxii.chat.ENVIRONMENT"
            android:value="staging" />

        <meta-data
            android:name="com.oxii.chat.API_BASE_URL"
            android:value="https://api-staging.oxii.chat" />

        <meta-data
            android:name="com.oxii.chat.ENABLE_DEBUG_TOOLS"
            android:value="true" />

        <!-- Staging notification channels -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />

    </application>

</manifest>
