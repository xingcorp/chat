<?xml version="1.0" encoding="utf-8"?>
<!-- Staging Network Security Config - Allow cleartext for development -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Staging API domains -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">api-staging.oxii.chat</domain>
        <domain includeSubdomains="true">ws-staging.oxii.chat</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>

    <!-- Firebase domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">firebaseio.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">firebasestorage.app</domain>
    </domain-config>
</network-security-config>
