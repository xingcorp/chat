# =============================================================================
# Fastlane Environment Variables
# =============================================================================
# Copy this file to .env.staging or .env.production and fill in the values
#
# Firebase Projects:
#   - Staging: common-stag (616861138934)
#   - Production: common-18e05 (159636416445)
# =============================================================================

# Build Number (auto-generated in CI/CD)
BUILD_NUMBER=

# =============================================================================
# Firebase App Distribution
# =============================================================================

# Staging Firebase App IDs
FIREBASE_IOS_STAGING_APP_ID=1:616861138934:ios:efbec74f31b43f9fd2d1d7
FIREBASE_ANDROID_STAGING_APP_ID=1:616861138934:android:fa6289969dad4284d2d1d7

# Production Firebase App IDs
FIREBASE_IOS_PRODUCTION_APP_ID=1:159636416445:ios:79b7effc0d4b095f2c94d4
FIREBASE_ANDROID_PRODUCTION_APP_ID=1:159636416445:android:ab0c406e42e583e62c94d4

# Firebase Service Account (JSON path or content)
# In CI/CD, use secrets. Locally, point to your service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH=

# =============================================================================
# App Store Connect (iOS)
# =============================================================================

# App Store Connect API Key
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=

# Apple Developer Team
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.oxii.chat

# =============================================================================
# Google Play Store (Android)
# =============================================================================

# Play Store Service Account JSON
PLAY_STORE_SERVICE_ACCOUNT_PATH=

# Play Store Package Name
ANDROID_PACKAGE_NAME=com.oxii.chat

# =============================================================================
# Code Signing (iOS)
# =============================================================================

# Match Configuration (for CI/CD)
MATCH_GIT_URL=
MATCH_PASSWORD=
MATCH_GIT_BRANCH=main

# Keychain (for CI/CD)
KEYCHAIN_NAME=fastlane_keychain
KEYCHAIN_PASSWORD=

# =============================================================================
# Code Signing (Android)
# =============================================================================

# Keystore Configuration
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
