# PRODUCTION ENVIRONMENT CONFIGURATION
# Environment variables cho production flavor

# Application Configuration
APP_NAME=OXII Chat
APP_VERSION=1.0.0+1
FLAVOR=production
ENVIRONMENT=production

# API Configuration
API_BASE_URL=https://api.oxii.chat
WEBSOCKET_URL=wss://ws.oxii.chat
API_VERSION=v1
API_TIMEOUT=15000

# Unified GraphQL/Realtime endpoints (Single Source of Truth)
GRAPHQL_API_URL=https://api.oxii.chat/graphql
GRAPHQL_WS_URL=wss://ws.oxii.chat/graphql
SOCKET_URL=wss://ws.oxii.chat

# Firebase Configuration
FIREBASE_PROJECT_ID=oxii-chat-prod
FIREBASE_API_KEY=AIzaSyProductionKey123456789
FIREBASE_APP_ID=1:987654321:android:prod987654321
FIREBASE_MESSAGING_SENDER_ID=987654321
FIREBASE_STORAGE_BUCKET=oxii-chat-prod.appspot.com

# Database Configuration
DATABASE_NAME=oxii_chat.db
DATABASE_VERSION=1
ENABLE_DATABASE_ENCRYPTION=true

# Security Configuration
ENABLE_SSL_PINNING=true
ENABLE_ROOT_DETECTION=true
ENABLE_JAILBREAK_DETECTION=true
JWT_SECRET=production_jwt_secret_key_secure

# Feature Flags
ENABLE_NEW_CHAT_UI=true
ENABLE_VOICE_MESSAGES=true
ENABLE_VIDEO_CALL=false
ENABLE_GROUP_CHAT=true
ENABLE_FILE_SHARING=true
ENABLE_LOCATION_SHARING=true
ENABLE_MESSAGE_REACTIONS=true
ENABLE_MESSAGE_FORWARDING=true
ENABLE_CHAT_BACKUP=true
ENABLE_END_TO_END_ENCRYPTION=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_DARK_MODE=true
ENABLE_NOTIFICATION_SCHEDULING=false
ENABLE_OFFLINE_MODE=true
ENABLE_ADVANCED_SEARCH=false

# Monitoring Configuration
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ANALYTICS_DEBUG_MODE=false

# Debug Configuration
LOG_LEVEL=ERROR
ENABLE_MOCK_DATA=false
ENABLE_DEBUG_TOOLS=false
ENABLE_NETWORK_LOGGING=false
ENABLE_PERFORMANCE_OVERLAY=false

# Cache Configuration
CACHE_TIMEOUT_MINUTES=30
MAX_CACHE_SIZE_MB=200
ENABLE_CACHE_ENCRYPTION=true

# Network Configuration
REQUEST_TIMEOUT_SECONDS=15
CONNECT_TIMEOUT_SECONDS=10
RECEIVE_TIMEOUT_SECONDS=15
MAX_RETRY_ATTEMPTS=2
RETRY_DELAY_SECONDS=1

# Push Notification Configuration
FCM_SERVER_KEY=production_fcm_server_key
ENABLE_PUSH_NOTIFICATIONS=true
NOTIFICATION_CHANNEL_ID=oxii_chat_notifications

# Third-party Services
GOOGLE_MAPS_API_KEY=production_google_maps_api_key
AGORA_APP_ID=production_agora_app_id
AGORA_APP_CERTIFICATE=production_agora_certificate

# Upload Configuration
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,mp4,mp3
UPLOAD_TIMEOUT_SECONDS=30

# Chat Configuration
MAX_MESSAGE_LENGTH=2000
MAX_GROUP_MEMBERS=200
MESSAGE_HISTORY_DAYS=180
ENABLE_MESSAGE_ENCRYPTION=true

# Performance Configuration
IMAGE_CACHE_SIZE_MB=100
VIDEO_CACHE_SIZE_MB=150
AUDIO_CACHE_SIZE_MB=50
PRELOAD_RECENT_CHATS=5

# Development Tools
ENABLE_FLUTTER_INSPECTOR=false
ENABLE_PERFORMANCE_PROFILER=false
ENABLE_MEMORY_PROFILER=false
ENABLE_NETWORK_PROFILER=false
