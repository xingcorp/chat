{
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "disabled": true,
      "autoApprove": []
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "working_directory": null,
      "autoApprove": [
        "sequentialthinking"
      ]
    },
    "Context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "ctx7sk-d0b3aba0-8da2-41a4-ba9d-40aaae17ab5d"
      ],
      "env": {},
      "working_directory": null,
      "start_on_launch": true,
      "autoApprove": [
        "resolve-library-id",
        "get-library-docs",
        "get-library-docs"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "autoApprove": [
